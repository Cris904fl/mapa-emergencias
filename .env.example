# ---- Base de datos (PostGIS) ----
# 5434 en el host: 5432, 5433 y 5435 ya los usan otros proyectos de esta
# máquina (aduanas_postgres, ocr_db). Dentro de Docker sigue siendo 5432.
POSTGRES_USER=emergencias
POSTGRES_PASSWORD=emergencias
POSTGRES_DB=emergencias
POSTGRES_PORT=5434
DATABASE_URL=postgres://emergencias:emergencias@localhost:5434/emergencias

# Base separada para la suite de pruebas. Nunca apuntar a la de desarrollo.
DATABASE_URL_TEST=postgres://emergencias:emergencias@localhost:5434/emergencias_test

# ---- Redis (cola de trabajos) ----
# 6381 porque ocr_redis ocupa 6380.
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# ---- API ----
API_PUERTO=3010
API_HOST=0.0.0.0
JWT_SECRETO=cambiar-en-produccion-por-un-valor-largo-y-aleatorio
LOG_NIVEL=info
# Directorio donde se guardan fotos/audio en desarrollo.
# En producción se reemplaza por S3/MinIO sin cambiar el resto del código.
ALMACEN_MEDIOS=./almacen

# ---- IA (extracción de texto libre) ----
# Opcional. Con 'ninguno' la API acepta reportes igual; quedan con
# origen_triage = 'CIUDADANO' y sin extracción automática.
#
#   ninguno    → sin extracción
#   ollama     → modelo local, gratis, los datos no salen de la máquina
#   compatible → cualquier API con forma OpenAI (Groq, OpenRouter, vLLM…)
#   anthropic  → API de Anthropic
IA_PROVEEDOR=ollama

# Con ollama: el nombre tal como lo lista `ollama list`.
# Con compatible: p. ej. llama-3.3-70b-versatile (Groq).
# Con anthropic: claude-opus-5.
IA_MODELO=qwen2.5:latest

IA_MAX_TOKENS=600

# Un 7B en CPU tarda 40-60 s por reporte. El límite es alto porque la
# extracción corre en un trabajador en segundo plano, no en la petición.
IA_TIEMPO_LIMITE_MS=180000

# ¿Puede el modelo escribir los campos canónicos sin que una persona revise?
# Dejarlo en false con modelos locales: ver docs/ia-local.md, sección de
# mediciones. La propuesta se guarda y se muestra igual; se aplica con un clic.
IA_APLICAR_AUTOMATICAMENTE=false

# --- ollama ---
OLLAMA_URL=http://localhost:11434

# --- compatible (Groq, OpenRouter, vLLM…) ---
IA_URL_COMPATIBLE=https://api.groq.com/openai/v1
IA_CLAVE_COMPATIBLE=

# --- anthropic ---
ANTHROPIC_API_KEY=

# Píxeles del lado largo a los que la PWA reduce cada foto antes de subirla.
# Reducir en el cliente ahorra datos en red degradada, además de tokens.
IA_IMAGEN_LADO_MAX=1568

# ---- Web (PWA) ----
VITE_API_URL=http://localhost:3010
