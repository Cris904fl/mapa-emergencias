# Entorno de la suite de pruebas.
#
# Apunta a una base SEPARADA (emergencias_test). Se versiona a propósito: no
# contiene secretos, solo credenciales locales de desarrollo, y así la suite
# corre igual en cualquier máquina sin configuración previa.
#
# IA_PROVEEDOR en 'ninguno' deliberadamente: ninguna prueba debe llamar a un
# servicio externo, gastar cuota, ni depender de que Ollama esté corriendo. La
# política de qué puede escribir un modelo se prueba con datos construidos a
# mano contra `calcularActualizacion`, sin inferencia real.
NODE_ENV=test
DATABASE_URL=postgres://emergencias:emergencias@localhost:5434/emergencias_test
REDIS_URL=redis://localhost:6381
API_PUERTO=3011
JWT_SECRETO=secreto-solo-para-pruebas-no-usar-en-produccion
LOG_NIVEL=silent
ALMACEN_MEDIOS=./almacen-pruebas
IA_PROVEEDOR=ninguno
IA_APLICAR_AUTOMATICAMENTE=false
